# Copie para .env e troque os valores. Valem só para o Postgres local do compose.yaml; nunca reaproveite em outro
# lugar. O .env fica fora do git.
POSTGRES_PASSWORD=troque-esta-senha-do-superusuario
APP_MIGRADOR_SENHA=troque-esta-senha-do-migrador
APP_RUNTIME_SENHA=troque-esta-senha-do-runtime
# Porta no 127.0.0.1 desta máquina.
POSTGRES_PORTA=55433
